page {
  background: linear-gradient(135deg, #c6ffdd 0%, #fbd786 50%, #f7797d 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.container {
  padding: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.btn {
  background: linear-gradient(135deg, #c6ffdd 0%, #fbd786 100%);
  border: none;
  border-radius: 25px;
  padding: 12px 30px;
  font-size: 16px;
  color: #333;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
}

.btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.input {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 10px;
  padding: 12px 15px;
  width: 200px;
  text-align: center;
  font-size: 18px;
  margin-bottom: 20px;
}

.title {
  font-size: 28px;
  font-weight: bold;
  color: #333;
  margin-bottom: 40px;
}