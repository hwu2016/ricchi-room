<view class="container">
  <view class="header">
    <text class="table-id">房间: {{tableId}}</text>
    <text class="status">{{status}}</text>
  </view>

  <view class="back-btn" bindtap="onLeave">
    <text class="back-arrow">←</text>
  </view>

  <view class="players">
    <view class="player {{item ? (item.is_owner ? 'owner' : '') : 'empty'}}" wx:for="{{playerSlots}}" wx:key="index" data-openid="{{item ? item.open_id : ''}}" bindtap="onPlayerTap">
      <image class="avatar-img" src="{{item ? item.avatar_url : ''}}" mode="aspectFill" wx:if="{{item && item.avatar_url}}"></image>
      <view class="avatar" wx:else>{{item ? item.nickname[0] : '?'}}</view>
      <text class="nickname">{{item ? item.nickname : '等待加入'}}</text>
      <text class="points" wx:if="{{item}}">{{item.points}}</text>
      <text class="owner-badge" wx:if="{{item && item.is_owner}}">房主</text>
    </view>
  </view>

  <view class="actions" wx:if="{{is_owner}}">
    <button class="btn settle-btn" bindtap="onSettle">结算</button>
  </view>

  <view class="modal" wx:if="{{showPayModal}}">
    <view class="modal-content">
      <text class="modal-title">支付点数</text>
      <picker mode="selector" range="{{payOptions}}" bindchange="onPayChange">
        <view class="pay-option">{{payOptions[payIndex] || '选择金额'}}</view>
      </picker>
      <button class="btn" bindtap="onConfirmPay">确认支付</button>
      <button class="btn cancel" bindtap="onCancelPay">取消</button>
    </view>
  </view>

  <view class="modal" wx:if="{{showSettleModal}}">
    <view class="modal-content">
      <text class="modal-title">结算结果</text>
      <view class="rank-item" wx:for="{{results}}" wx:key="rank">
        <text class="rank">第{{item.rank}}名</text>
        <text class="rank-name">{{item.nickname}}</text>
        <text class="rank-points">{{item.points}}</text>
      </view>
      <button class="btn" bindtap="onDismiss">解散房间</button>
      <button class="btn" bindtap="onNextRound">再来一局</button>
    </view>
  </view>
</view>